# Application Server Port
PORT=8000
API_PORT=8000

# Docker Host Port Mappings (0 enables dynamic OS ephemeral port allocation)
AIDLC_FRONTEND_PORT=0
AIDLC_API_PORT=0
AIDLC_DB_PORT=0

# PostgreSQL Configuration
POSTGRES_USER=cyberheist
POSTGRES_PASSWORD=cyberheist_secret
POSTGRES_DB=cyberheist_db
DATABASE_URL=postgres://cyberheist:cyberheist_secret@localhost:5432/cyberheist_db

# JWT Configuration
JWT_SECRET=cyberheist_jwt_super_secret_key_2026
JWT_EXPIRES_IN=24h

# Node Environment
NODE_ENV=development
