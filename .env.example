# Project Cyber Heist - Environment Configuration
# Dynamic host port mappings (default 0 for ephemeral port allocation)
AIDLC_FRONTEND_PORT=0
AIDLC_API_PORT=0
AIDLC_DB_PORT=0

# Fixed internal container ports
PORT=8000
API_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432

# Runtime Environment
AIDLC_ENVIRONMENT=local
NODE_ENV=development

# JWT Authentication
JWT_SECRET=cyber-heist-dev-secret-key-32-chars-minimum!
JWT_EXPIRES_IN=24h

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cyber_heist
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cyber_heist
