{
  "name": "project-cyber-heist",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "prebuild": "node -e \"if (!require('fs').existsSync('node_modules')) { console.log('Installing dependencies...'); require('child_process').execSync('npm install --prefer-offline --no-audit', {stdio: 'inherit'}); }\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "pretest": "node -e \"if (!require('fs').existsSync('node_modules')) { console.log('Installing dependencies...'); require('child_process').execSync('npm install --prefer-offline --no-audit', {stdio: 'inherit'}); }\"",
    "test": "vitest run",
    "prelint": "node -e \"if (!require('fs').existsSync('node_modules')) { console.log('Installing dependencies...'); require('child_process').execSync('npm install --prefer-offline --no-audit', {stdio: 'inherit'}); }\"",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "start": "node server/dist/index.js",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
